			"type": "color",
			"defaultValue": "#ffffff",
			"showIf": "useCustomColors",
			"group": "Appearance"
		},
		{
			"id": "color2",
			"label": "Secondary Color",
			"description": "",
			"type": "color",
			"defaultValue": "#1d1d1d",
			"showIf": "useCustomColors",
			"group": "Appearance"
		},
		{
			"id": "showWhilePaused",
